# Copy this file to `.env` and fill in your key.
# `.env` is gitignored; `.env.example` is committed as a template.
#
# Usage:
#   cp .env.example .env
#   vi .env                              # fill in OPENAI_API_KEY=sk-...
#   chmod 600 .env                       # user-only read
#
# The LLM eval scripts source it automatically (qs_load_env in
# experiments/_lib/llm_lib.sh).

OPENAI_API_KEY=sk-REPLACE_ME

# Root of your local dataset copy (not distributed with the repo). Board lists
# and split configs reference it as ${CADAGENT_DATA_ROOT}/<sub>; the expected
# layout of the subs is documented in configs/paths.yaml.
# CADAGENT_DATA_ROOT=/path/to/datasets
