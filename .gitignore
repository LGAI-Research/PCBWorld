# Root .gitignore — SHIPS PUBLICLY (the public export copies it), so it never names the private
# trees; each private tree carries its own .gitignore.
#
# Rule (user 2026-08-31): a folder is ignored AT ITS PATH — folder patterns start with `/`.
# A bare `name/` matches at every depth and silently swallows a same-named folder elsewhere:
# new files under a tracked directory then never show up in `git status`/`git add` (it hid the
# private mirrors of experiments/ and configs/datasets/). Only true artifacts that are never
# source anywhere (__pycache__/, *.pyc, wandb/, CMakeFiles/, editor/OS droppings) stay unanchored.
# tools/docs/check_docs.py `gitignore-traps` fails when any tracked directory would swallow a new file.

/examples/

# RL act-server shared-secret auth cert — never commit, never share.
# Auto-generated by the (private) RL act server on first run.
.cadagent_auth.cert

# Python
# uv.lock: project uses `uv pip compile pyproject.toml -> requirements.txt`, not `uv sync`.
uv.lock
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments at the repo root (engine/.gitignore covers its own)
/.venv/
/venv/
/ENV/
/env/

# Local secrets
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Build artifacts
# anchored: the top-level build dirs only (tools/build/ is tracked source)
/build/
/build_rl/
/build_rl_dev/
CMakeFiles/

# AI tool configs
.omc/
**/AGENTS.md
# Per-developer local instruction files (personal conventions) are never shared.
*.local.md
AGENT.md
.cursorrules

# Training data — root-level data dirs (configs/datasets/ is tracked and unaffected)
/datasets/
/configs/datasets/local/
/datasets_local/

# Training artifacts written at the repo root by older scripts (var/ otherwise)
/checkpoints/
/checkpoints_*/
/tb_logs/

# Test output
/tests/output/

# Demo output
/output/
/outputs/

# KiCad lock files
*.lck
# KiCad autosave files
_autosave-*
# KiCad local settings
*.kicad_prl
# KiCad history folder
/tests/fixtures/.history/
# KiCad project files
*.kicad_pro
# ...except test fixture pros: the engine load contract requires a .kicad_pro
# next to every board, so fixture boards ship with their pair (a clone without
# them fails every engine test loudly).
!/tests/fixtures/*.kicad_pro
!/tests/fixtures/**/*.kicad_pro

# Experiment logs & caches at the repo root (experiments/ itself is TRACKED reproduction recipes)
/logs/
/cache/
# wandb writes its run dir into the current working directory — an artifact wherever it lands
wandb/

# pcbdataset history
/pcb_dataset/.history/
# PCB dataset directories (local, not tracked)
/dataset/
/pcb_dataset/
/pcb_dataset_*

# Scratch code: not reproducible and imported by nothing. Generated data and
# results belong in var/ instead.
/sandbox/

# Ad-hoc run outputs (routed boards, eval artifacts, checkpoints, tb) from campaign
# scripts that write outside the var/ convention. Generated data, never source.
/runs/

# Vendored rule-based-router release binary — Freerouting jar (~66 MB, not source).
# Auto-downloaded by methods/baselines/rule_based/scripts/setup_env.sh; pinned via docs.
/external/freerouting/*.jar
# Pinned upstream checkout made by tools/setup/fetch_baselines.sh (KRT_ROOT)
/external/KiCadRoutingTools/
